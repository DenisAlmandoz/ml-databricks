{
  "expectation_suite_name": "customer_contract_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_ordered_list",
      "kwargs": {
        "column_list": [
          "customer_id",
          "age",
          "annual_income",
          "tenure_months",
          "monthly_spend",
          "support_tickets",
          "plan_type",
          "high_value"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "plan_type",
        "value_set": [
          "basic",
          "pro",
          "enterprise"
        ]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "age",
        "min_value": 18,
        "max_value": 100
      }
    }
  ]
}